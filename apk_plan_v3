  // Tabela ćwiczeń dla jednego tygodnia
  function buildExTable(wi) {
    let rows = '';
    exercises.forEach((sec, si) => {
      sec.items.forEach((ex, ei) => {
        const plan = ex.loads[wi] || '—';
        const actual = realData[`${si}-${ei}-${wi}`] || '—';
        const isActual = actual !== '—';
        rows += `<tr>
          <td style="padding:7px 10px;font-size:12px;color:#ccc">${ex.name}</td>
          <td style="padding:7px 10px;font-size:12px;color:#888;white-space:nowrap">${plan}</td>
