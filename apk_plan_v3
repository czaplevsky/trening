        </tr>`;
      });
    });
    return rows;
  }

  // Sekcja tygodnia w eksporcie
  function buildWeekSection(wi) {
    const w = weeks[wi];
    const days = schedule[wi];
    const activeDays = days.filter(d => d.rpe || d.difficulty);

    const dayRows = activeDays.map(d => {
      const diffColor = {Easy:'#6ddcb4',Medium:'#c9a0ff',Hard:'#ff7a6a',Deload:'#f0c060'}[d.difficulty] || '#888';
