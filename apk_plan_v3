    .meta { font-size: 12px; color: #888; margin-bottom: 28px; font-weight: 300; }
  </style>
</head>
<body>
  <h1>Plan Treningowy</h1>
  <div class="meta">Eksport · ${dateStr}</div>
  ${allWeekSections}
  <div style="text-align:center;font-size:11px;color:#333;padding:32px 0;font-weight:300">Plan Treningowy · Eksport wygenerowany ${dateStr}</div>

  <!-- DANE PLANU — blok maszynowy do reimportu. Nie usuwaj. -->
  <script id="plan-data" type="application/json">
${JSON.stringify(payload, null, 2)}
  </sc` + `ript>
</body>
</html>`;
}

function downloadBulkHTML() {
  const html = buildExportHTML();
  const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'plan_treningowy_export.html';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
  const statusEl = document.getElementById('export-status');
  statusEl.textContent = '✓ Pobieranie rozpoczęte';
  setTimeout(() => { statusEl.textContent = ''; }, 2500);
}

// ─── NORMALIZACJA DANYCH (v1.1 compat) ──────────────────────────
const DOT_MAP = {
  'Poniedziałek': 'd-mon', 'Wtorek': 'd-tue', 'Środa': 'd-wed',
  'Czwartek': 'd-thu', 'Piątek': 'd-fri', 'Sobota': 'd-sat', 'Niedziela': 'd-sun'
};

function normalizeWeeks(raw) {
  return raw.map((w, i) => {
    if (typeof w === 'string') {
      // Prompt v4.5 fallback: weeks jako stringi → konwertuj na obiekty
      const isLast = i === raw.length - 1;
      return { label: w, phase: isLast ? 'Deload' : (i === 0 ? 'Rozruch' : 'Progresja'), isDeload: isLast };
    }
    return {
      label: w.label || `Tydzień ${i + 1}`,
      phase: w.phase || '',
      isDeload: !!w.isDeload
    };
  });
}

function normalizeSchedule(raw) {
  return raw.map(week =>
    week.map(d => ({
      day:        d.day || 'Dzień',
      dot:        d.dot || DOT_MAP[d.day] || 'd-mon',
      activity:   d.activity || '',
      detail:     d.detail || '',
      rpe:        d.rpe !== undefined ? d.rpe : null,
      difficulty: d.difficulty !== undefined ? d.difficulty : null
    }))
  );
}

function normalizeExercises(raw, numWeeks) {
  return raw.map(sec => ({
    section: sec.section || '',
    tag:     sec.tag || 'tag-wed',
    items:   (sec.items || []).map(ex => {
      let loads = ex.loads || [];
      // Dopasuj długość loads do liczby tygodni
      while (loads.length < numWeeks) loads.push('—');
      if (loads.length > numWeeks) loads = loads.slice(0, numWeeks);
      return { name: ex.name || '', meta: ex.meta || '', loads };
    })
  }));
}

// ─── DYNAMICZNE TABY ĆWICZEŃ ────────────────────────────────────
function rebuildExWeekTabs() {
  const container = document.getElementById('ex-week-tabs');
  if (!container) return;
  container.innerHTML = weeks.map((w, i) => {
    const short = w.label.replace(/Tydzień\s*/, 'Tyg. ');
    return `<button class="tab${i === 0 ? ' active' : ''}" onclick="switchExWeek(${i}, this)">${short}</button>`;
  }).join('');
}

// ─── IMPORT — FileReader + DOMParser ─────────────────────────────
function handleImport(input) {
  const file = input.files[0];
  if (!file) return;
  input.value = ''; // reset, żeby można było importować ten sam plik

  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const parser = new DOMParser();
      const doc = parser.parseFromString(e.target.result, 'text/html');
      const scriptTag = doc.getElementById('plan-data');

      if (!scriptTag) {
        alert('Nie znaleziono bloku danych w pliku.\nUpewnij się, że importujesz plik z tagiem <script id="plan-data">.');
        return;
      }

      const data = JSON.parse(scriptTag.textContent);

      if (!data.weeks || !data.schedule || !data.exercises) {
        alert('Nieprawidłowa struktura danych w pliku (brak weeks/schedule/exercises).');
        return;
      }

      // Normalizacja — obsługuje zarówno v1.0 (export HTML) jak i v1.1 (prompt AI)
      const normWeeks = normalizeWeeks(data.weeks);
      const normSchedule = normalizeSchedule(data.schedule);
      const normExercises = normalizeExercises(data.exercises, normWeeks.length);

      // Hydratacja stanu — podmiana in-place
      weeks.length = 0;
      weeks.push(...normWeeks);

      schedule.length = 0;
      schedule.push(...normSchedule);

      exercises.length = 0;
      exercises.push(...normExercises);

      // Import realData jeśli dostępne (reimport wcześniejszego eksportu)
      if (data.realData && typeof data.realData === 'object' && Object.keys(data.realData).length > 0) {
        Object.keys(realData).forEach(k => delete realData[k]);
        Object.assign(realData, data.realData);
        try { localStorage.setItem('realData', JSON.stringify(realData)); } catch(e) {}
      } else {
        // Nowy plan — wyczyść postęp
        try { localStorage.removeItem('realData'); } catch(e) {}
        Object.keys(realData).forEach(k => delete realData[k]);
      }

      // Zawsze czyść checkboxy przy imporcie
      try { localStorage.removeItem('checkedDays'); } catch(e) {}
      Object.keys(checkedDays).forEach(k => delete checkedDays[k]);

      // Aktualizacja nagłówka nawigatora
      const planName = data.planName || (weeks[0] && weeks[0].label) || 'Plan Treningowy';
      document.getElementById('nav-title').textContent = planName;
      if (data.exportDate) {
        document.getElementById('nav-sub').textContent = 'Zaimportowano · ' + data.exportDate;
      }

      // Aktualizacja wskaźników tygodni (dots)
      const dotsContainer = document.querySelector('.week-dots');
      dotsContainer.innerHTML = weeks.map((_, i) =>
        `<div class="dot${i === 0 ? ' active' : ''}" id="dot-${i}"></div>`
      ).join('');

      // Dynamiczne taby ćwiczeń
      rebuildExWeekTabs();

      // Reset stanu i rerenderowanie
      currentWeek = 0;
      currentExWeek = 0;
      renderSchedule();
      renderExercises();

      // Banner potwierdzenia
      const banner = document.getElementById('import-banner');
      const hasRealData = data.realData && Object.keys(data.realData).length > 0;
      banner.innerHTML = `✓ <strong>Plan zaimportowany</strong> — ${weeks.length} tygodnie` +
        (hasRealData ? `, wyniki zachowane` : `, postęp zresetowany`) + `.`;
      banner.classList.add('visible');
      setTimeout(() => banner.classList.remove('visible'), 5000);

    } catch(err) {
      alert('Błąd podczas importu: ' + err.message);
    }
  };

  reader.readAsText(file, 'UTF-8');
}

// ─── INIT ────────────────────────────────────────────────────────
rebuildExWeekTabs();
renderSchedule();
renderExercises();
</script>
