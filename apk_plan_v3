// ─── EXPORT — PODGLĄD PODSUMOWANIA ───────────────────────────────
function renderExportOverview() {
  let html = '';
  weeks.forEach((w, wi) => {
    // policz wypełnione pola realData dla tego tygodnia
    let filledCount = 0;
    let totalCount = 0;
    exercises.forEach((sec, si) => {
      sec.items.forEach((ex, ei) => {
        totalCount++;
        if (realData[`${si}-${ei}-${wi}`]) filledCount++;
      });
    });

    html += `<div class="export-summary-card">`;
    html += `<div class="export-summary-head">
      <span>${w.label}</span>
      <span style="font-size:11px;color:var(--text-3);font-weight:300">${w.phase}</span>
    </div>`;
    schedule[wi].forEach(d => {
      if (!d.rpe && !d.difficulty) return; // pomijaj REST / SEKCJA
      const badges = buildBadges(d);
      html += `<div class="export-summary-row">
        <div>
          <div class="export-summary-day">${d.day} · ${d.activity}</div>
          <div class="export-summary-detail">${d.detail}</div>
          ${badges ? `<div style="margin-top:6px">${badges.replace('class="badges-row"','class="badges-row" style="margin-top:0"')}</div>` : ''}
        </div>
      </div>`;
    });
    html += `<div class="export-summary-row" style="background:rgba(255,255,255,0.02)">
      <span style="font-size:11px;color:var(--text-3)">Wyniki wpisane</span>
      <span class="export-realdata-count${filledCount === 0 ? ' zero' : ''}">${filledCount}/${totalCount}</span>
    </div>`;
    html += `</div>`;
  });

  document.getElementById('export-overview').innerHTML = html;
}

