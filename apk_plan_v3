<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#0a0a0a">
<title>Plan Treningowy</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0a0a;
    --surface: #141414;
    --surface2: #1c1c1c;
    --border: rgba(255,255,255,0.07);
    --border-strong: rgba(255,255,255,0.13);
    --text: #f0f0f0;
    --text-2: #888;
    --text-3: #555;
    --accent: #f0f0f0;
    --tag-mon: rgba(80,140,255,0.15);
    --tag-mon-text: #7eb8f7;
    --tag-wed: rgba(180,120,255,0.15);
    --tag-wed-text: #c9a0ff;
    --tag-fri: rgba(255,120,100,0.15);
    --tag-fri-text: #ff9a8b;
    --tag-sat: rgba(80,200,160,0.15);
    --tag-sat-text: #6ddcb4;
    --tag-deload: rgba(255,200,80,0.12);
    --tag-deload-text: #f0c060;
    --r: 16px;
    --r-sm: 10px;
    --safe-top: env(safe-area-inset-top);
    --safe-bot: env(safe-area-inset-bottom);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100dvh;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* ── TOP NAV ── */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: calc(var(--safe-top) + 12px) 20px 12px;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-title { font-size: 17px; font-weight: 500; letter-spacing: -0.3px; }
  .nav-sub { font-size: 12px; color: var(--text-2); font-weight: 300; margin-top: 1px; }

  /* ── NAV BUTTON (Import) ── */
  .nav-btn {
    padding: 6px 13px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 400;
    color: var(--text-2);
    cursor: pointer;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    font-family: 'DM Sans', sans-serif;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-btn:active { background: var(--surface2); color: var(--text); }

  /* ── TAB BAR ── */
  .tab-bar {
    display: flex;
    gap: 6px;
    padding: 12px 20px;
    overflow-x: auto;
    scrollbar-width: none;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 65px;
    z-index: 99;
  }
  .tab-bar::-webkit-scrollbar { display: none; }
  .tab {
    flex-shrink: 0;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 400;
    color: var(--text-2);
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .tab.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
    font-weight: 500;
  }

  /* ── MAIN ── */
  main { padding: 0 0 calc(var(--safe-bot) + 32px); }

  .section { display: none; }
  .section.active { display: block; }

  /* ── WEEK SELECTOR ── */
  .week-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 20px 4px;
  }
  .week-label { font-size: 22px; font-weight: 500; letter-spacing: -0.5px; }
  .week-phase {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--text-2);
    margin-top: 2px;
  }
  .week-arrows { display: flex; gap: 8px; }
  .arrow-btn {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 16px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.15s;
  }
  .arrow-btn:active { background: var(--surface2); }
  .arrow-btn:disabled { opacity: 0.25; cursor: default; }

  /* ── WEEK DOTS ── */
  .week-dots {
    display: flex;
    gap: 6px;
    padding: 10px 20px 20px;
  }
  .dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
    transition: all 0.2s;
  }
  .dot.active { width: 18px; border-radius: 3px; background: var(--text); }

  /* ── DAY CARD ── */
  .day-card {
    margin: 8px 16px;
    background: var(--surface);
    border-radius: var(--r);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .day-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .day-left { display: flex; align-items: center; gap: 12px; }
  .day-dot {
    width: 8px; height: 8px; border-radius: 50%;
    flex-shrink: 0;
  }
  .day-name { font-size: 15px; font-weight: 500; }
  .day-activity { font-size: 12px; color: var(--text-2); margin-top: 1px; font-weight: 300; }
  .day-chevron {
    font-size: 12px;
    color: var(--text-3);
    transition: transform 0.25s ease;
  }
  .day-card.open .day-chevron { transform: rotate(180deg); }
  .day-body { display: none; }
  .day-card.open .day-body { display: block; }

  /* ── EXERCISE ROW ── */
  .ex-group { padding: 12px 16px; border-bottom: 1px solid var(--border); }
  .ex-group:last-child { border-bottom: none; }
  .ex-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    line-height: 1.4;
  }
  .ex-meta {
    font-size: 11px;
    color: var(--text-2);
    margin-top: 2px;
    font-weight: 300;
  }
  .ex-load {
    margin-top: 8px;
    font-family: 'DM Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.3px;
  }
  .ex-load.deload { color: var(--tag-deload-text); }

  /* ── TAG ── */
  .tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 4px;
    margin-bottom: 10px;
  }
  .tag-mon { background: var(--tag-mon); color: var(--tag-mon-text); }
  .tag-wed { background: var(--tag-wed); color: var(--tag-wed-text); }
  .tag-fri { background: var(--tag-fri); color: var(--tag-fri-text); }
  .tag-sat { background: var(--tag-sat); color: var(--tag-sat-text); }
  .tag-deload { background: var(--tag-deload); color: var(--tag-deload-text); }

  /* ── RPE / DIFFICULTY BADGES ── */
  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.4px;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .badge-rpe {
    background: rgba(255,160,50,0.12);
    color: #ffaa44;
    border: 1px solid rgba(255,160,50,0.2);
  }
  .badge-diff-easy {
    background: rgba(80,200,160,0.12);
    color: #6ddcb4;
    border: 1px solid rgba(80,200,160,0.2);
  }
  .badge-diff-medium {
    background: rgba(180,120,255,0.12);
    color: #c9a0ff;
    border: 1px solid rgba(180,120,255,0.2);
  }
  .badge-diff-hard {
    background: rgba(255,100,80,0.12);
    color: #ff7a6a;
    border: 1px solid rgba(255,100,80,0.2);
  }
  .badge-diff-deload {
    background: rgba(240,192,96,0.12);
    color: #f0c060;
    border: 1px solid rgba(240,192,96,0.2);
  }

  /* ── RULE CARD ── */
  .rule-block {
    margin: 8px 16px;
    background: var(--surface);
    border-radius: var(--r);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .rule-head {
    padding: 14px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rule-icon { font-size: 16px; }
  .rule-item {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .rule-item:last-child { border-bottom: none; }
  .rule-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    margin-bottom: 4px;
    letter-spacing: 0.2px;
  }
  .rule-text {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text);
    font-weight: 300;
  }
  .rule-text strong { font-weight: 500; color: var(--text); }

  /* ── SECTION HEADER ── */
  .sec-header {
    padding: 28px 20px 12px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--text-3);
  }

  /* ── OVERVIEW GRID ── */
  .overview-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 0 16px;
  }
  .ov-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    padding: 14px;
  }
  .ov-day { font-size: 11px; color: var(--text-2); font-weight: 500; margin-bottom: 4px; letter-spacing: 0.3px; }
  .ov-act { font-size: 13px; font-weight: 400; line-height: 1.35; }

  /* ── DELOAD BANNER ── */
  .deload-banner {
    margin: 8px 16px;
    padding: 14px 16px;
    background: rgba(240,192,96,0.07);
    border: 1px solid rgba(240,192,96,0.2);
    border-radius: var(--r);
    font-size: 13px;
    font-weight: 300;
    color: var(--tag-deload-text);
    line-height: 1.5;
  }
  .deload-banner strong { font-weight: 500; }

  /* ── REAL INPUT ── */
  .real-wrap { margin-top: 8px; display: flex; align-items: center; gap: 8px; }
  .real-input {
    flex: 1;
    background: var(--surface2);
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    padding: 7px 10px;
    outline: none;
    -webkit-appearance: none;
    transition: border-color 0.15s;
  }
  .real-input:focus { border-color: rgba(255,255,255,0.3); }
  .real-input::placeholder { color: var(--text-3); }
  .real-label { font-size: 10px; color: var(--text-3); flex-shrink: 0; }

  /* ── FOOTER ── */
  .footer {
    text-align: center;
    padding: 32px 20px;
    font-size: 12px;
    color: var(--text-3);
    font-weight: 300;
  }

  /* ── DIVIDER ── */
  .divider { height: 1px; background: var(--border); margin: 0 16px; }

  /* ── EKSPORT (refaktoryzacja — bulk HTML download) ── */
  .export-summary-card {
    margin: 8px 16px;
    background: var(--surface);
    border-radius: var(--r);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .export-summary-head {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    letter-spacing: 0.3px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .export-summary-row {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .export-summary-row:last-child { border-bottom: none; }
  .export-summary-day { font-size: 13px; font-weight: 400; }
  .export-summary-detail { font-size: 11px; color: var(--text-2); font-weight: 300; margin-top: 2px; }
  .export-realdata-count {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: #30d158;
    flex-shrink: 0;
  }
  .export-realdata-count.zero { color: var(--text-3); }
  .export-actions {
    padding: 16px 16px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .export-btn-primary {
    width: 100%;
    padding: 15px;
    border-radius: var(--r-sm);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    background: #30d158;
    color: #000;
    -webkit-tap-highlight-color: transparent;
    transition: opacity 0.15s;
    font-family: 'DM Sans', sans-serif;
  }
  .export-btn-primary:active { opacity: 0.75; }
  .export-note {
    padding: 0 16px;
    font-size: 11px;
    color: var(--text-3);
    font-weight: 300;
    line-height: 1.6;
    text-align: center;
  }
  .export-status {
    text-align: center;
    font-size: 12px;
    color: #30d158;
    padding: 8px 16px 0;
    min-height: 24px;
  }

  /* ── IMPORT BANNER ── */
  .import-banner {
    margin: 8px 16px;
    padding: 12px 16px;
    background: rgba(80,200,160,0.07);
    border: 1px solid rgba(80,200,160,0.2);
    border-radius: var(--r);
    font-size: 12px;
    font-weight: 300;
    color: var(--tag-sat-text);
    line-height: 1.5;
    display: none;
  }
  .import-banner.visible { display: block; }
  .import-banner strong { font-weight: 500; }

  /* dot colors */
  .d-mon { background: #888; }
  .d-tue { background: #888; }
  .d-wed { background: var(--tag-wed-text); }
  .d-thu { background: #888; }
  .d-fri { background: var(--tag-fri-text); }
  .d-sat { background: var(--tag-sat-text); }
  .d-sun { background: #444; }

  /* ── CHECKBOX ── */
  .day-check {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    background: transparent;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: all 0.2s ease;
    font-size: 13px;
    color: transparent;
  }
  .day-check.checked {
    background: #30d158;
    border-color: #30d158;
    color: #000;
  }
  .day-card.done .day-name { color: var(--text-2); }
  .day-card.done .day-activity { color: var(--text-3); }
  .day-card.done .day-dot { opacity: 0.3; }
</style>
</head>
<body>

<nav>
  <div>
    <div class="nav-title" id="nav-title">Plan Treningowy</div>
    <div class="nav-sub" id="nav-sub">Wspinaczka & Siłownia · Tygodnie 13–16</div>
  </div>
  <div style="display:flex;align-items:center;gap:8px">
    <button class="nav-btn" onclick="document.getElementById('import-file').click()">⬆ Importuj</button>
    <input type="file" id="import-file" accept=".html" style="display:none" onchange="handleImport(this)">
  </div>
</nav>

<div class="tab-bar">
  <button class="tab active" onclick="switchTab('schedule')">Harmonogram</button>
  <button class="tab" onclick="switchTab('exercises')">Ćwiczenia</button>
  <!-- TAB ZASADY — wyłączona, zarezerwowana do reaktywacji komercyjnej
  <button class="tab" onclick="switchTab('rules')">Zasady</button>
  -->
  <button class="tab" onclick="switchTab('export')">⬇ Eksport</button>
</div>

<main>

<!-- ══════════════════════════════════════════
     TAB 1: HARMONOGRAM
══════════════════════════════════════════ -->
<section id="tab-schedule" class="section active">

  <div class="week-nav">
    <div>
      <div class="week-label" id="week-label">Tydzień 13</div>
      <div class="week-phase" id="week-phase">Rozruch</div>
    </div>
    <div class="week-arrows">
      <button class="arrow-btn" id="btn-prev" onclick="changeWeek(-1)" disabled>←</button>
      <button class="arrow-btn" id="btn-next" onclick="changeWeek(1)">→</button>
    </div>
  </div>

  <div class="week-dots">
    <div class="dot active" id="dot-0"></div>
    <div class="dot" id="dot-1"></div>
    <div class="dot" id="dot-2"></div>
    <div class="dot" id="dot-3"></div>
  </div>

  <div id="import-banner" class="import-banner"></div>
  <div id="week-content"></div>

</section>

<!-- ══════════════════════════════════════════
     TAB 2: ĆWICZENIA
══════════════════════════════════════════ -->
<section id="tab-exercises" class="section">

  <div class="sec-header">Wybierz tydzień</div>
  <div class="tab-bar" style="position:static; top:auto;" id="ex-week-tabs">
    <!-- Generowane dynamicznie przez rebuildExWeekTabs() -->
  </div>

  <div id="ex-content"></div>

</section>

