<!-- ══════════════════════════════════════════
     TAB 4: EKSPORT — BULK HTML DOWNLOAD
══════════════════════════════════════════ -->
<section id="tab-export" class="section">

  <div class="sec-header">Podsumowanie planu</div>
  <div id="export-overview"></div>

  <div class="export-actions">
    <button class="export-btn-primary" onclick="downloadBulkHTML()">⬇ Pobierz wszystkie tygodnie</button>
