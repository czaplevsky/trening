      const diffChip = d.difficulty ? `<span style="background:rgba(255,255,255,0.06);color:${diffColor};padding:2px 7px;border-radius:4px;font-size:10px;font-weight:500">${d.difficulty}</span>` : '';
      return `<div style="padding:9px 16px;border-bottom:1px solid rgba(255,255,255,0.06)">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
          <div>
            <span style="font-size:13px;font-weight:500;color:#f0f0f0">${d.day}</span>
            <span style="font-size:12px;color:#888;margin-left:8px">${d.activity}</span>
          </div>
          <div>${rpeChip}${diffChip}</div>
        </div>
        <div style="font-size:11px;color:#666;margin-top:3px">${d.detail}</div>
