// ─── BADGE HELPER ────────────────────────────────────────────────
function buildBadges(d) {
  const parts = [];
  if (d.rpe) {
    parts.push(`<span class="badge badge-rpe">RPE ${d.rpe}</span>`);
  }
  if (d.difficulty) {
    const cls = 'badge-diff-' + d.difficulty.toLowerCase();
    const label = {
      Easy:   'Łatwe',
      Medium: 'Średnie',
      Hard:   'Ciężkie',
      Deload: 'Deload'
    }[d.difficulty] || d.difficulty;
    parts.push(`<span class="badge ${cls}">${label}</span>`);
  }
  return parts.length ? `<div class="badges-row">${parts.join('')}</div>` : '';
}

// ─── RENDER SCHEDULE ─────────────────────────────────────────────
function renderSchedule() {
  const w = weeks[currentWeek];
  document.getElementById('week-label').textContent = w.label;
  document.getElementById('week-phase').textContent = w.phase;
  document.getElementById('btn-prev').disabled = currentWeek === 0;
  document.getElementById('btn-next').disabled = currentWeek === weeks.length - 1;

  for (let i = 0; i < weeks.length; i++) {
    const d = document.getElementById('dot-' + i);
    if (d) d.className = 'dot' + (i === currentWeek ? ' active' : '');
  }

  const days = schedule[currentWeek];
  const html = days.map((d, idx) => {
    const key = `${currentWeek}-${idx}`;
    const done = !!checkedDays[key];
    const badges = buildBadges(d);
    return `
    <div class="day-card${done ? ' done' : ''}" id="card-${idx}">
      <div class="day-header" onclick="toggleDay(${idx})">
        <div class="day-left">
          <div class="day-dot ${d.dot}"></div>
          <div>
            <div class="day-name">${d.day}</div>
            <div class="day-activity">${d.activity}</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
          <div class="day-check${done ? ' checked' : ''}" id="chk-${idx}"
            onclick="toggleCheck(event, ${idx})">✓</div>
          <span class="day-chevron">▼</span>
        </div>
      </div>
      <div class="day-body">
        <div class="ex-group">
          <div class="ex-meta">${d.detail}</div>
          ${badges}
        </div>
      </div>
    </div>`;
  }).join('');

  document.getElementById('week-content').innerHTML =
    (w.isDeload ? `<div class="deload-banner">⟳ <strong>Tydzień Deload</strong> — objętość -50%, intensywność niska. Celem jest pełna regeneracja przed kolejnym cyklem.</div>` : '') + html;
}

function toggleDay(idx) {
  const card = document.getElementById('card-' + idx);
  card.classList.toggle('open');
}

function toggleCheck(e, idx) {
  e.stopPropagation();
  const key = `${currentWeek}-${idx}`;
  checkedDays[key] = !checkedDays[key];
  try { localStorage.setItem('checkedDays', JSON.stringify(checkedDays)); } catch(e) {}
  renderSchedule();
}

