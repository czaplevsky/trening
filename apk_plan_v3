function buildExportHTML() {
  const now = new Date();
  const dateStr = now.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' });

  // Payload JSON (osadzony w pliku)
  const payload = {
    version: "1.1",
    planName: weeks[0].label.replace(/Tydzień \d+/, 'Plan Treningowy'),
