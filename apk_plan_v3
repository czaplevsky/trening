      : '';

    return `
    <div style="margin:20px 0;background:#141414;border:1px solid rgba(255,255,255,0.09);border-radius:14px;overflow:hidden">
      <div style="padding:14px 16px;border-bottom:1px solid rgba(255,255,255,0.07);display:flex;align-items:baseline;gap:12px">
        <span style="font-size:18px;font-weight:500;color:#f0f0f0">${w.label}</span>
        <span style="font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.8px;font-weight:500">${w.phase}</span>
      </div>
      ${deloadBanner}
      ${dayRows}
    </div>
    <div style="margin:12px 0 20px;background:#141414;border:1px solid rgba(255,255,255,0.09);border-radius:14px;overflow:hidden">
      <div style="padding:10px 16px;border-bottom:1px solid rgba(255,255,255,0.07);font-size:11px;color:#666;text-transform:uppercase;letter-spacing:0.8px">Ćwiczenia · wyniki</div>
      <table style="width:100%;border-collapse:collapse">
        <thead><tr>
          <th style="padding:7px 10px;font-size:10px;color:#555;text-align:left;font-weight:500;text-transform:uppercase;letter-spacing:0.5px">Ćwiczenie</th>
          <th style="padding:7px 10px;font-size:10px;color:#555;text-align:left;font-weight:500;text-transform:uppercase;letter-spacing:0.5px">Plan</th>
          <th style="padding:7px 10px;font-size:10px;color:#555;text-align:left;font-weight:500;text-transform:uppercase;letter-spacing:0.5px">Wykonano</th>
        </tr></thead>
        <tbody>${buildExTable(wi)}</tbody>
      </table>
    </div>`;
  }

  const allWeekSections = weeks.map((_, wi) => buildWeekSection(wi)).join('');

  return `<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plan Treningowy — Eksport ${dateStr}</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #0a0a0a; color: #f0f0f0; margin: 0; padding: 24px 20px; max-width: 680px; margin: 0 auto; padding: 24px 20px; }
